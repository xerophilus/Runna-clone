# Cadence — environment configuration
# Copy to .env and fill in. NEVER commit real secrets.

# --- Supabase (client) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Edge Function secrets (server-side only; set via `supabase secrets set`) ---
# The Anthropic key lives ONLY here — the client never holds it (spec §3, §7).
ANTHROPIC_API_KEY=
# Optional model overrides. Copywriting is cheap/batched, so operators may set
# CADENCE_COPY_MODEL=claude-haiku-4-5 to trim cost.
CADENCE_COPY_MODEL=claude-opus-4-8
CADENCE_PARSE_MODEL=claude-opus-4-8

# --- Observability ---
SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
